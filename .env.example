# WhatsApp Cloud API (painel da Meta > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=invente-um-texto-e-repita-no-painel
WHATSAPP_APP_SECRET=

# Número do Gabriel que recebe os avisos (formato internacional, sem + e sem espaços)
NOTIFY_NUMBER=5511974019394

# IA (opcional: sem a chave, o assistente responde só com o menu e os atalhos)
GROQ_API_KEY=

# Banco: vazio usa SQLite local; em produção, a string do Neon
